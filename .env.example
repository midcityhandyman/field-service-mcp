# Copy to .env and export the values in your shell or MCP client config.
# Every value is optional. With nothing set, the server runs fully offline
# against the bundled mock API mounted in process.

# Which adapter to use: a registered name (mock) or package.module:ClassName
FSM_ADAPTER=mock

# Base URL of the vendor API. Leave empty to run the mock in process.
# Set to http://127.0.0.1:8765 after starting: python -m field_service_mcp.mock_api
FSM_BASE_URL=

# API key sent to the vendor. "mock-key" is the public placeholder the mock accepts.
# Never commit a real key.
FSM_API_KEY=mock-key

# true hides every create_* tool, leaving a read-only server.
FSM_READ_ONLY=false

# Vendor HTTP behaviour
FSM_TIMEOUT_SECONDS=10
FSM_MAX_RETRIES=2

# Working hours used by find_open_slots (local time, HH:MM)
FSM_WORKDAY_START=08:00
FSM_WORKDAY_END=17:00

# MCP transport: stdio (default) or streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Mock API only: the date the seeded schedule is built around.
# An ISO date, or "today". Default is 2030-01-07 so demos are reproducible.
MOCK_ANCHOR_DATE=
MOCK_API_HOST=127.0.0.1
MOCK_API_PORT=8765
